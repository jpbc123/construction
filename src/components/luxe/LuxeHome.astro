---
/**
 * "luxe" layout: a premium, one-page, bilingual (EN / 中文) home for clients whose
 * JSON sets "layout": "luxe" and supplies a `luxe` block. Every text field is
 * { en, zh }. Only facts from the client's JSON are shown; there are no
 * placeholder stats, team, blog or email.
 */
import fs from 'node:fs';
import path from 'node:path';
import L from './L.astro';
import Icon from '../Icon.astro';
import { waLink } from '../../lib/clients.js';

const { client } = Astro.props;
const { company, copy, luxe } = client;

// Only show photos that are actually in /public (so a missing download never renders a broken image).
const exists = (src) => fs.existsSync(path.join(process.cwd(), 'public', src.replace(/^\//, '')));
const work = luxe.work.items.filter((w) => exists(w.image));
const reviews = luxe.reviews ?? [];

const wa = waLink(client);
const tel = (n) => `tel:${n.replace(/[^+\d]/g, '')}`;
const year = new Date().getFullYear();
const nav = [
  { id: 'why', label: { en: 'Why us', zh: '优势' } },
  { id: 'services', label: { en: 'Services', zh: '服务' } },
  { id: 'work', label: { en: 'Our work', zh: '作品' } },
  { id: 'process', label: { en: 'Process', zh: '流程' } },
  { id: 'contact', label: { en: 'Contact', zh: '联系' } },
];
const pad = (i) => String(i + 1).padStart(2, '0');
---

<div class="lx" id="lx">
  <header class="lx-header">
    <div class="lx-wrap lx-header-inner">
      <a class="lx-logo" href="#top" aria-label={`${company.name}, back to top`}>
        <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
          <path d="M6 19 20 7l14 12v14H6z" fill="none" stroke="url(#lxg)" stroke-width="2" stroke-linejoin="round" />
          <path d="M15 33V22h10v11" fill="none" stroke="url(#lxg)" stroke-width="2" />
          <defs>
            <linearGradient id="lxg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f3dfa2" /><stop offset=".55" stop-color="#c9a45c" /><stop offset="1" stop-color="#8a6a2f" />
            </linearGradient>
          </defs>
        </svg>
        <span class="lx-logo-text">
          <span class="lx-logo-name">MISS <b>RENOVATE</b></span>
          <span class="lx-logo-sub">BEYOND SATISFACTION</span>
        </span>
      </a>
      <nav class="lx-nav" aria-label="Sections">
        {nav.map((n) => <a href={`#${n.id}`}><L v={n.label} /></a>)}
      </nav>
      <div class="lx-header-actions">
        <button class="lx-lang" type="button" id="lx-lang" aria-label="Switch language / 切换语言">
          <span data-l="en">中文</span><span data-l="zh">EN</span>
        </button>
        <a class="lx-btn lx-btn-gold lx-header-cta" href={wa} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <section class="lx-hero" id="top" aria-labelledby="lx-hero-h">
    <div class="lx-wrap lx-hero-grid">
      <div class="lx-hero-copy">
        <a class="lx-rating" href={company.google.url} target="_blank" rel="noopener">
          <span class="lx-stars" aria-hidden="true">★★★★★</span>
          <span><b>{company.google.rating}</b> · <L v={{ en: `${company.google.reviews} Google reviews`, zh: `${company.google.reviews} 条 Google 评价` }} /></span>
        </a>
        <p class="lx-eyebrow"><L v={luxe.hero.eyebrow} /></p>
        <h1 id="lx-hero-h"><L v={luxe.hero.heading} /></h1>
        <p class="lx-lede"><L v={luxe.hero.lede} /></p>
        <div class="lx-actions">
          <a class="lx-btn lx-btn-gold" href={wa} target="_blank" rel="noopener">
            <L v={{ en: 'Free consultation on WhatsApp', zh: 'WhatsApp 免费咨询' }} />
          </a>
          <a class="lx-btn lx-btn-line" href={tel(company.hotline)}>
            <L v={{ en: `Hotline ${company.hotline}`, zh: `热线 ${company.hotline}` }} />
          </a>
        </div>
      </div>
      <figure class="lx-hero-media">
        {/* The source photo stacks BEFORE (top half) over AFTER (bottom half); the slider shows them side by side. */}
        <div class="lx-ba" id="lx-ba" style="--pos: 50%;">
          <img
            class="lx-ba-after"
            src={luxe.hero.image}
            alt={luxe.hero.imageAlt.en}
            data-alt-zh={luxe.hero.imageAlt.zh}
            data-alt-en={luxe.hero.imageAlt.en}
            width="960"
            height="540"
            loading="eager"
            fetchpriority="high"
          />
          <img class="lx-ba-before" src={luxe.hero.image} alt="" width="960" height="540" loading="eager" />
          <span class="lx-ba-tag lx-ba-tag-before"><L v={{ en: 'Before', zh: '装修前' }} /></span>
          <span class="lx-ba-tag lx-ba-tag-after"><L v={{ en: 'After', zh: '装修后' }} /></span>
          <span class="lx-ba-line" aria-hidden="true"><span class="lx-ba-knob">‹ ›</span></span>
          <input class="lx-ba-range" id="lx-ba-range" type="range" min="0" max="100" value="50" aria-label="Before / after: drag to compare" />
        </div>
        <figcaption><L v={{ en: 'Our kitchen job, before and after. Drag to compare.', zh: '我们的厨房案例：装修前后，拖动对比。' }} /></figcaption>
      </figure>
    </div>
    <div class="lx-values" aria-label="Mindful, Innovative, Skilful, Sincere">
      {luxe.values.map((v) => <span><b>{v[0]}</b>{v.slice(1)}</span>)}
    </div>
  </section>

  <!-- Why -->
  <section class="lx-section" id="why" aria-labelledby="lx-why-h">
    <div class="lx-wrap">
      <div class="lx-head">
        <p class="lx-kicker">01</p>
        <h2 id="lx-why-h"><L v={luxe.why.heading} /></h2>
        <p class="lx-quote"><L v={luxe.why.intro} /></p>
      </div>
      <ol class="lx-why">
        {
          luxe.why.items.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
              <span class="lx-num">{pad(i)}</span>
              <h3><L v={item.title} /></h3>
              <p><L v={item.text} /></p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Services -->
  <section class="lx-section lx-alt" id="services" aria-labelledby="lx-svc-h">
    <div class="lx-wrap">
      <div class="lx-head">
        <p class="lx-kicker">02</p>
        <h2 id="lx-svc-h"><L v={luxe.services.heading} /></h2>
      </div>
      <div class="lx-svc-grid">
        {
          luxe.services.items.map((s, i) => (
            <article class="lx-svc" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <span class="lx-icon"><Icon name={s.icon} size={26} /></span>
              <h3><L v={s.title} /></h3>
              <p><L v={s.text} /></p>
            </article>
          ))
        }
      </div>
      <div class="lx-design" data-reveal>
        <h3><L v={luxe.services.design.heading} /></h3>
        <ul>
          {luxe.services.design.points.map((p) => <li><L v={p} /></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Work -->
  {
    work.length > 0 && (
      <section class="lx-section" id="work" aria-labelledby="lx-work-h">
        <div class="lx-wrap">
          <div class="lx-head">
            <p class="lx-kicker">03</p>
            <h2 id="lx-work-h"><L v={luxe.work.heading} /></h2>
            <p class="lx-sub"><L v={luxe.work.intro} /></p>
          </div>
          <div class="lx-gallery">
            {work.map((w, i) => (
              <figure class={i === 0 ? 'lx-shot lx-shot-wide' : 'lx-shot'} data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                <img src={w.image} alt={w.caption.en} data-alt-en={w.caption.en} data-alt-zh={w.caption.zh} width="960" height="1080" loading="lazy" />
                <figcaption><L v={w.caption} /></figcaption>
              </figure>
            ))}
          </div>
          <p class="lx-source">
            <a href={company.facebook} target="_blank" rel="noopener">
              <L v={{ en: 'More on our Facebook →', zh: '更多作品请看我们的 Facebook →' }} />
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- Process -->
  <section class="lx-section lx-alt" id="process" aria-labelledby="lx-proc-h">
    <div class="lx-wrap">
      <div class="lx-head">
        <p class="lx-kicker">04</p>
        <h2 id="lx-proc-h"><L v={luxe.process.heading} /></h2>
      </div>
      <ol class="lx-steps" id="lx-steps">
        {
          luxe.process.steps.map((s, i) => (
            <li class="lx-step">
              <span class="lx-step-n">{pad(i)}</span>
              <h3><L v={s.title} /></h3>
              <p><L v={s.text} /></p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Reviews -->
  <section class="lx-section" id="reviews" aria-labelledby="lx-rev-h">
    <div class="lx-wrap">
      <div class="lx-head">
        <p class="lx-kicker">05</p>
        <h2 id="lx-rev-h"><L v={{ en: 'What our clients say', zh: '客户评价' }} /></h2>
      </div>
      <a class="lx-score" href={company.google.url} target="_blank" rel="noopener">
        <span class="lx-score-n">{company.google.rating}</span>
        <span>
          <span class="lx-stars" aria-hidden="true">★★★★★</span><br />
          <L v={{ en: `from ${company.google.reviews} reviews on Google Maps`, zh: `来自 Google 地图的 ${company.google.reviews} 条评价` }} />
        </span>
      </a>
      {
        reviews.length > 0 && (
          <div class="lx-reviews">
            {reviews.map((r, i) => (
              <figure class="lx-review" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
                <span class="lx-stars" aria-label={`${r.stars} stars`}>{'★'.repeat(r.stars)}</span>
                <blockquote>
                  {r.text}
                  {r.translation && <span class="lx-tr" data-l="en">“{r.translation}” (translated by Google)</span>}
                </blockquote>
                <figcaption>{r.name} · Google</figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="lx-section lx-alt" id="contact" aria-labelledby="lx-contact-h">
    <div class="lx-wrap lx-contact">
      <div>
        <p class="lx-kicker">06</p>
        <h2 id="lx-contact-h"><L v={luxe.contact.heading} /></h2>
        <ul class="lx-details">
          <li>
            <span class="lx-dt">WhatsApp</span>
            <a href={wa} target="_blank" rel="noopener">{company.whatsappDisplay}</a>
          </li>
          <li>
            <span class="lx-dt"><L v={{ en: 'Hotline', zh: '热线' }} /></span>
            <a href={tel(company.hotline)}>{company.hotline}</a>
          </li>
          <li>
            <span class="lx-dt"><L v={{ en: 'Phone', zh: '电话' }} /></span>
            <a href={tel(company.phone)}>{company.phone}</a>
          </li>
          <li>
            <span class="lx-dt"><L v={{ en: 'Office', zh: '办公室' }} /></span>
            <span>
              {company.address}<br />
              <a href={company.mapsUrl} target="_blank" rel="noopener"><L v={{ en: 'Open in Google Maps →', zh: '在 Google 地图打开 →' }} /></a>
            </span>
          </li>
          <li>
            <span class="lx-dt"><L v={{ en: 'Areas', zh: '服务地区' }} /></span>
            <span><L v={luxe.contact.areas} /></span>
          </li>
        </ul>
      </div>

      <form class="lx-form" id="lx-form" novalidate data-wa={company.whatsapp}>
        <p class="lx-form-note"><L v={{ en: 'Send this form and it opens WhatsApp with your details filled in.', zh: '提交后将打开 WhatsApp，并自动填好您的资料。' }} /></p>
        <label>
          <span><L v={{ en: 'Name', zh: '姓名' }} /></span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span><L v={{ en: 'Property type', zh: '房屋类型' }} /></span>
          <select name="property" required>
            <option value="" data-en="Select…" data-zh="请选择…">Select…</option>
            {luxe.contact.propertyTypes.map((p) => <option value={p.en} data-en={p.en} data-zh={p.zh}>{p.en}</option>)}
          </select>
        </label>
        <label>
          <span><L v={{ en: 'Budget', zh: '预算' }} /></span>
          <select name="budget" required>
            <option value="" data-en="Select…" data-zh="请选择…">Select…</option>
            {copy.budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
        <label>
          <span><L v={{ en: 'Area', zh: '地区' }} /></span>
          <input name="area" placeholder="e.g. Setia Alam" data-ph-en="e.g. Setia Alam" data-ph-zh="例如：Setia Alam" />
        </label>
        <label class="lx-full">
          <span><L v={{ en: 'What would you like done?', zh: '您想装修什么？' }} /></span>
          <textarea name="details" rows="4"></textarea>
        </label>
        <p class="lx-error" id="lx-form-error" role="alert" hidden><L v={{ en: 'Please fill in your name, property type and budget.', zh: '请填写姓名、房屋类型和预算。' }} /></p>
        <button class="lx-btn lx-btn-gold lx-full" type="submit"><L v={{ en: 'Send on WhatsApp', zh: '通过 WhatsApp 发送' }} /></button>
      </form>
    </div>
  </section>

  <footer class="lx-footer">
    <div class="lx-wrap lx-footer-inner">
      <div>
        <div class="lx-footer-name">{company.legalName}</div>
        <div class="lx-footer-tag">{company.tagline} — Beyond Satisfaction</div>
      </div>
      <div class="lx-footer-links">
        <a href={company.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={wa} target="_blank" rel="noopener">WhatsApp</a>
        <a href={company.mapsUrl} target="_blank" rel="noopener">Google Maps</a>
      </div>
      <div class="lx-footer-copy">© {year} {company.legalName}</div>
    </div>
  </footer>

  <a class="lx-float" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M9.2 8.8c.3-.1.6 0 .8.4l.6 1.1c.1.3 0 .6-.2.8l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.2-.2.5-.3.8-.2l1.1.6c.4.2.5.5.4.8-.2.7-.9 1.2-1.7 1.1-2.6-.3-4.9-2.6-5.2-5.2-.1-.8.4-1.5 1.1-1.7z" fill="currentColor"/></svg>
  </a>
</div>

<script>
  const root = document.documentElement;
  const KEY = 'lx-lang';

  const apply = (lang) => {
    root.dataset.lang = lang;
    root.lang = lang === 'zh' ? 'zh-Hans' : 'en';
    document.querySelectorAll('[data-alt-en]').forEach((el) => {
      el.setAttribute('alt', el.getAttribute(`data-alt-${lang}`) ?? '');
    });
    document.querySelectorAll('option[data-en]').forEach((el) => {
      el.textContent = el.getAttribute(`data-${lang}`);
    });
    document.querySelectorAll('[data-ph-en]').forEach((el) => {
      el.setAttribute('placeholder', el.getAttribute(`data-ph-${lang}`) ?? '');
    });
  };

  let initial = 'en';
  try {
    const saved = localStorage.getItem(KEY);
    if (saved === 'en' || saved === 'zh') initial = saved;
  } catch {}
  apply(initial);

  document.getElementById('lx-lang')?.addEventListener('click', () => {
    const next = root.dataset.lang === 'zh' ? 'en' : 'zh';
    apply(next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
  });

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Before / after slider. The range input does the work (mouse, touch, keyboard).
  const ba = document.getElementById('lx-ba');
  const range = document.getElementById('lx-ba-range');
  if (ba && range instanceof HTMLInputElement) {
    const set = (v) => ba.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => set(range.value));
    // One gentle sweep on load so people see it's draggable.
    if (!reduceMotion) {
      const frames = [50, 28, 72, 50];
      let i = 0;
      let touched = false;
      range.addEventListener('pointerdown', () => (touched = true), { once: true });
      const step = () => {
        if (touched || i >= frames.length) return;
        ba.style.transition = 'none';
        const from = i === 0 ? 50 : frames[i - 1];
        const to = frames[i];
        const start = performance.now();
        const tick = (now) => {
          if (touched) return;
          const t = Math.min((now - start) / 700, 1);
          const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          const v = from + (to - from) * eased;
          set(v);
          range.value = String(Math.round(v));
          if (t < 1) requestAnimationFrame(tick);
          else {
            i += 1;
            setTimeout(step, 120);
          }
        };
        requestAnimationFrame(tick);
      };
      setTimeout(step, 900);
    }
  }

  // Process steps: scroll-driven, not timers (same as the ai-concierge "trust" section),
  // so it plays the same scrolling down or back up. The section pins in the middle of
  // the screen; the 1st card shows once it is pinned, then every STEP px of scrolling
  // shows the next; after the last one it stays pinned STEP px more so it can be read,
  // then scrolls on. On phones, if the whole section is too tall to pin, the card list
  // pins instead; if even that won't fit, each card shows once it reaches 75% down.
  const stepList = document.getElementById('lx-steps');
  if (stepList && !reduceMotion && window.requestAnimationFrame) {
    const STEP = 260; // about 2-3 mouse-wheel notches
    const SIDE = 130; // unpinned fallback: stagger cards in the same row
    const items = [...stepList.children];
    const wrap = stepList.closest('section')?.querySelector('.lx-wrap');
    const header = document.querySelector('.lx-header');
    stepList.classList.add('reveal');
    let u = null;
    let ticking = false;

    const reset = () => {
      if (!u) return;
      if (u.pin) {
        u.pin.classList.remove('lx-pinned');
        u.pin.style.top = '';
      }
      u.spacer?.remove();
      u = null;
    };
    const update = () => {
      ticking = false;
      if (!u) return;
      if (u.pin) {
        // px scrolled since pinning: where the pin would be without sticky vs where it is held
        const d = u.top - (u.pin.parentNode.getBoundingClientRect().top + u.nat);
        const shown = d < 0 ? 0 : Math.min(items.length, 1 + Math.floor(d / STEP));
        items.forEach((it, i) => it.classList.toggle('is-in', i < shown));
      } else {
        const line = window.innerHeight * 0.75;
        items.forEach((it, i) => it.classList.toggle('is-in', it.getBoundingClientRect().top + u.cols[i] * SIDE < line));
      }
    };
    const layout = () => {
      reset();
      const head = header ? header.offsetHeight : 0;
      const room = window.innerHeight - head - 32;
      const candidates = window.innerWidth < 900 ? [wrap, stepList] : [wrap];
      u = { pin: null };
      for (const c of candidates) {
        if (c && c.offsetHeight <= room) {
          u.pin = c;
          break;
        }
      }
      if (u.pin) {
        u.nat = u.pin.getBoundingClientRect().top - u.pin.parentNode.getBoundingClientRect().top;
        u.top = head + (window.innerHeight - head - u.pin.offsetHeight) / 2;
        u.pin.classList.add('lx-pinned');
        u.pin.style.top = `${u.top}px`;
        u.spacer = document.createElement('div');
        u.spacer.setAttribute('aria-hidden', 'true');
        u.spacer.style.gridColumn = '1 / -1';
        u.spacer.style.height = `${items.length * STEP}px`;
        u.pin.parentNode.insertBefore(u.spacer, u.pin.nextSibling);
      }
      // column index of each card within its row, for the unpinned fallback
      u.cols = items.map((it, i) => {
        let c = 0;
        for (let j = i - 1; j >= 0 && Math.abs(items[j].offsetTop - it.offsetTop) < 2; j--) c++;
        return c;
      });
      update();
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', layout);
    // Fonts change heights; lay out again once they've loaded.
    document.fonts?.ready.then(layout);
    layout();
  }

  // Quote form -> WhatsApp with the details filled in (no backend needed).
  const form = document.getElementById('lx-form');
  const error = document.getElementById('lx-form-error');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const get = (k) => String(data.get(k) ?? '').trim();
    if (!get('name') || !get('property') || !get('budget')) {
      if (error) error.hidden = false;
      return;
    }
    if (error) error.hidden = true;
    const lines = [
      'Hi Miss Renovate, I would like a free consultation.',
      `Name: ${get('name')}`,
      `Property: ${get('property')}`,
      `Budget: ${get('budget')}`,
      get('area') && `Area: ${get('area')}`,
      get('details') && `Details: ${get('details')}`,
    ].filter(Boolean);
    const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>

<style>
  :global(body:has(.lx)) {
    background: #0b0a08;
    color: #ece6da;
  }
  :global(html:not([data-lang='zh'])) :global([data-l='zh']),
  :global(html[data-lang='zh']) :global([data-l='en']) {
    display: none;
  }

  .lx {
    --gold: #c9a45c;
    --gold-hi: #f0d898;
    --gold-lo: #8a6a2f;
    --gold-grad: linear-gradient(120deg, #f3dfa2 0%, #c9a45c 45%, #8a6a2f 100%);
    --ink: #0b0a08;
    --ink-2: #14120e;
    --ink-3: #1d1a14;
    --ivory: #ece6da;
    --muted: #a59d8d;
