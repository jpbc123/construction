---
import { url } from '../lib/clients.js';

const { client } = Astro.props;
const company = client.company;
const services = client.services;
const copy = client.copy;

const year = new Date().getFullYear();

const socialIcons = {
  LinkedIn:
    '<path d="M4.5 9.5v10M4.5 6.5v.01M9.5 19.5v-6a3 3 0 0 1 6 0v6M9.5 9.5v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>',
  Instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.7" fill="none"/><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.7" fill="none"/><circle cx="16.8" cy="7.2" r="1" fill="currentColor"/>',
  Facebook:
    '<path d="M14.5 8.5H16V5.75h-2a3.5 3.5 0 0 0-3.5 3.5V11H8.5v2.75h2V20h3v-6.25h2.1l.4-2.75h-2.5V9.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>',
  WhatsApp:
    '<path d="M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M9.2 8.8c.3-.1.6 0 .8.4l.6 1.1c.1.3 0 .6-.2.8l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.2-.2.5-.3.8-.2l1.1.6c.4.2.5.5.4.8-.2.7-.9 1.2-1.7 1.1-2.6-.3-4.9-2.6-5.2-5.2-.1-.8.4-1.5 1.1-1.7z" fill="currentColor"/>',
  TikTok:
    '<path d="M14 4.5v9.8a3 3 0 1 1-2.4-2.9" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/><path d="M14 4.5c.4 2 1.8 3.4 3.8 3.6" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"/>',
  Pinterest:
    '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M11 17.5 12.6 11m-1.4-1.4a2 2 0 1 1 3.3 1.9c-.8.9-2.3.7-2.8-.4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>',
  WeChat:
    '<ellipse cx="9.5" cy="10" rx="5.5" ry="4.5" stroke="currentColor" stroke-width="1.6" fill="none"/><ellipse cx="15.5" cy="15" rx="4.5" ry="3.8" stroke="currentColor" stroke-width="1.6" fill="none"/>',
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href={url(client)} aria-label={`${company.name} — home`}>
          <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="#F6F4EF"></rect>
            <path d="M9 23V9h3l8 10V9h3v14h-3L12 13v10z" fill="#16222E"></path>
            <rect x="9" y="25" width="14" height="2" fill="#B4532A"></rect>
          </svg>
          <span>{company.name}</span>
        </a>
        <p>
          {company.legalName}. {company.tagline} Serving {copy.serviceArea} since{' '}
          {company.founded}.
        </p>
        <div class="footer-social">
          {
            company.social.map((s) => (
              <a href={s.url} aria-label={`${company.name} on ${s.name}`}>
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" set:html={socialIcons[s.name] ?? ''} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Footer — company">
        <h4>Company</h4>
        <ul>
          <li><a href={url(client, 'about')}>About us</a></li>
          <li><a href={url(client, 'portfolio')}>Portfolio</a></li>
          <li><a href={url(client, 'services')}>Services</a></li>
          <li><a href={url(client, 'quote')}>Request a quote</a></li>
        </ul>
      </nav>

      <nav aria-label="Footer — services">
        <h4>Services</h4>
        <ul>
          {
            services.slice(0, 4).map((s) => (
              <li>
                <a href={`${url(client, 'services')}#${s.slug}`}>{s.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={`tel:${company.phone.replace(/[^+\d]/g, '')}`}>{company.phone}</a></li>
          <li>{company.address}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {company.legalName} All rights reserved.</span>
      <span>Licensed &amp; insured · {copy.licence}</span>
    </div>
  </div>
</footer>
